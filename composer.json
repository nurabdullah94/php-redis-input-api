{
    "name": "company/php-redis-import-api",
    "description": "REST API for importing products with Redis Queue",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "predis/predis": "^2.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
