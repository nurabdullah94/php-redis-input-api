# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=csv
UPLOAD_PATH=uploads/
