# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=product_import
DB_USER=root
DB_PASS=

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
